<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivLock"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_lock_idle_lock"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modo Conductor"
        android:textColor="@color/primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/ivLock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa el PIN de acceso"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/pinContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/pin1"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="@drawable/pin_edit_background"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/pin2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="@drawable/pin_edit_background"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/pin3"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="@drawable/pin_edit_background"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/pin4"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="@drawable/pin_edit_background" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/error"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/pinContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnIngresar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIngresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingresar"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/tvError"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="64dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
